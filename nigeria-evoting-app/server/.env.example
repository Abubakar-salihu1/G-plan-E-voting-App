# Copy to .env and fill in. NEVER commit .env.
DATABASE_URL="postgresql://naijavote:naijavote_dev_pw@localhost:5432/naijavote?schema=public"

# Each of these must be unique, random and secret:
#   JWT_SECRET, HASH_PEPPER      ->  openssl rand -base64 48
#   DATA_ENCRYPTION_KEY          ->  openssl rand -hex 32   (exactly 64 hex chars)
JWT_SECRET=
HASH_PEPPER=
DATA_ENCRYPTION_KEY=

PORT=4000
CLIENT_ORIGIN="http://localhost:5173"

# Set to true when running behind a reverse proxy / load balancer.
TRUST_PROXY=false

# 'demo' does NO real face matching and is refused when NODE_ENV=production.
FACE_PROVIDER=demo

# true = face check only SUBMITS the voter; an admin must approve them.
REQUIRE_ADMIN_APPROVAL=false

# Email delivery for OTP codes and admin invites. Leave blank in development to
# have codes shown on screen instead. When set, codes are emailed and NOT shown.
#   Gmail:  SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  SMTP_USER=you@gmail.com
#           SMTP_PASS=<16-character Google App Password>   MAIL_FROM="NaijaVote <you@gmail.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Optional seed overrides (otherwise a random password is generated and printed once):
# SEED_ADMIN_EMAIL=
# SEED_ADMIN_PASSWORD=

# Passkeys (fingerprint / face unlock). Auto-detected in GitHub Codespaces.
# Elsewhere set the exact https address voters open (required in production):
# WEBAUTHN_ORIGIN=https://vote.example.ng
